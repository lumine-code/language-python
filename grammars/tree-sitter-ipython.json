{
  "name": "IPython",
  "scopeName": "source.python.ipy",
  "type": "tree-sitter",
  "parser": "tree-sitter-python",
  "injectionRegex": "^(ipy|IPY|ipython|IPython|IPYTHON)$",
  // `\bpython` in the Python grammar's patterns cannot match inside "ipython",
  // so these never compete with it.
  "firstLineRegex": [
    // shebang line
    "^#![ \\t]*/.*\\bipython[\\d\\.]*\\b",
    // vim modeline
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=ipython"
  ],
  "fileTypes": ["ipy"],
  "treeSitter": {
    // The lumine-code fork extends upstream with IPython-only statements
    // (magic_statement, shell_statement, help_statement) so .ipy sources parse
    // without ERROR nodes. Plain .py files stay on the pure upstream parser
    // above, which this fork is merged up to, so both agree on tree shape.
    "parserSource": "github:lumine-code/tree-sitter-python#ff6556893780d54bfbc3360a43375949aa4c4d3e",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "ts/tree-sitter-ipython.wasm",
    "highlightsQuery": ["ts/highlights.scm", "ts/ipython-highlights.scm"],
    "tagsQuery": "ts/tags.scm",
    "foldsQuery": "ts/folds.scm",
    "indentsQuery": "ts/indents.scm"
  }
}
