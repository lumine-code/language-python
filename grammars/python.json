{
  "name": "Python",
  "scopeName": "source.python",
  "type": "tree-sitter",
  "parser": "tree-sitter-python",
  "injectionNames": ["py", "python"],
  "firstLineRegex": [
    // shebang line
    "^#![ \\t]*/.*\\bpython[\\d\\.]*\\b",
    // vim modeline
    "vim\\b.*\\bset\\b.*\\b(filetype|ft|syntax)=python"
  ],
  "fileTypes": [
    "py",
    "pyi",
    "pyw",
    "gyp",
    "gypi",
    "SConstruct",
    "Sconstruct",
    "sconstruct",
    "SConscript",
    "tac",
    "wscript",
    "wsgi"
  ],
  "treeSitter": {
    // One commit past v0.25.0, and still untagged upstream: it makes
    // `expression_statement` a supertype, so that node no longer appears in
    // the tree and a bare `a, b` becomes `tuple_expression`.
    "parserSource": "github:tree-sitter/tree-sitter-python#26855eabccb19c6abf499fbc5b8dc7cc9ab8bc64",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "python.wasm",
    "highlightsQuery": "python-highlights.scm",
    "tagsQuery": "python-tags.scm",
    "foldsQuery": "python-folds.scm",
    "indentsQuery": "python-indents.scm"
  }
}
