{
  "name": "Python",
  "scopeName": "source.python",
  "type": "tree-sitter",
  "parser": "tree-sitter-python",
  "injectionNames": ["py", "py3", "python", "python3"],
  "firstLineRegex": [
    // shebang line
    "^#![ \\t]*/.*\\bpython[\\d\\.]*\\b",
    // vim modeline
    // Stop at the first Vim and set tokens instead of backtracking over them.
    // \x0a keeps existing shebang prefix line counts unchanged.
    "(?:^|\\x0a)(?:(?!vim\\b).)*vim\\b(?:(?!\\bset\\b).)*\\bset\\b.*\\b(filetype|ft|syntax)=python"
  ],
  "fileTypes": [
    "py",
    "pyi",
    "pyw",
    "gyp",
    "gypi",
    "SConstruct",
    "Sconstruct",
    "sconstruct",
    "SConscript",
    "tac",
    "wscript",
    "wsgi"
  ],
  "treeSitter": {
    // Based on upstream 26855eab, one commit past v0.25.0: it makes
    // `expression_statement` a supertype, so that node no longer appears in
    // the tree and a bare `a, b` becomes `tuple_expression`.
    // The maintained source fork keeps Python syntax unchanged and avoids
    // repeated scanner lookahead through module-level comment runs.
    "parserSource": "github:lumine-code/tree-sitter-python#1820ef598ff4d8bd82b843e13ac2959062e53a73",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "python.wasm",
    "highlightsQuery": "python-highlights.scm",
    "tagsQuery": "python-tags.scm",
    "foldsQuery": "python-folds.scm",
    "indentsQuery": "python-indents.scm"
  }
}
