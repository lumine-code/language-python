{
  "name": "language-python",
  "author": "lumine-code",
  "version": "1.0.0",
  "files": [
    "grammars",
    "settings",
    "snippets",
    "spec",
    "THIRD_PARTY_NOTICES"
  ],
  "description": "Python language support.",
  "keywords": [
    "pyi",
    "pyw",
    "wsgi",
    "tree-sitter"
  ],
  "engines": {
    "lumine": "^1.0.0",
    "node": ">=24"
  },
  "specPackages": [
    "language-log"
  ],
  "repository": "https://github.com/lumine-code/language-python",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lumine-code/language-python/issues"
  },
  "configSchema": {
    "highlightConstants": {
      "title": "Highlight Uppercase Constants",
      "description": "Highlight ALL_CAPS names as constants. When disabled, names use their usual variable or property highlighting.",
      "type": "boolean",
      "default": true
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "dedent": "^1.7.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
